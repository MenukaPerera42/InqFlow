# Development-only values. Change the password before sharing a local environment.
POSTGRES_USER=inquiry_dev
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=inquiry_dev
POSTGRES_PORT=5432
# Express API (optional; defaults to 3001)
PORT=3001

# Keep these URLs consistent with the PostgreSQL values above. URL-encode special password characters.
DATABASE_URL=postgresql://inquiry_dev:replace_with_local_password@localhost:5432/inquiry_dev?schema=public
TEST_DATABASE_URL=postgresql://inquiry_dev:replace_with_local_password@localhost:5432/inquiry_dev?schema=inquiry_test
SEED_STAFF_PASSWORD=replace_with_a_12_character_development_password

# Authentication (local HTTP development). Generate a random 32+ character value.
SESSION_SECRETS=replace_with_a_random_secret_of_at_least_32_characters
FRONTEND_ORIGINS=http://localhost:3000
