{
  "name": "customer-inquiry-system",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @inquiry/web",
    "dev:api": "npm run dev -w @inquiry/api",
    "build": "npm run db:generate && npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "node --env-file=.env node_modules/prisma/build/index.js generate --schema apps/api/prisma/schema.prisma",
    "db:validate": "node --env-file=.env node_modules/prisma/build/index.js validate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "node --env-file=.env node_modules/prisma/build/index.js migrate dev --schema apps/api/prisma/schema.prisma",
    "db:deploy": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "node --env-file=.env --import tsx apps/api/src/db/seed.ts",
    "db:test:prepare": "node apps/api/scripts/prepare-test-db.mjs",
    "test:db": "node --env-file=.env node_modules/vitest/vitest.mjs run --root apps/api src/tests/database.integration.test.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
